# ===========================================
# Backend — Environment Variables
# ===========================================

NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_log_analyzer
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# CORS
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=50000000
